# Python AI service environment variables — placeholders only, never commit real values.
# The service reads the same PostgreSQL credentials as the backend to load face embeddings.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PWD=your-db-password

# Shared secret used in BOTH directions:
# 1) sent as the `x-service-key` header when POSTing detection alerts to the Node
#    backend (see _fire_alert in main.py);
# 2) required (as `X-AI-Service-Key`) on inbound calls to the face endpoints
#    /api/encode-faces, /user/recognize and /refresh — only the Node backend may
#    call them. If unset, the check is skipped (LOCAL DEV ONLY — never deploy
#    without it). Must match server/.env's AI_SERVICE_KEY.
# For local dev you may use a simple value like "dev-local-ai-key".
AI_SERVICE_KEY=your-shared-ai-service-secret

# Browser origins allowed by CORS (comma-separated). The face endpoints are called
# by the Node backend (no CORS needed), but the YOLO stream endpoints are still
# browser-fetched in development. Never use a wildcard with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
